# Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================================
# MongoDB Atlas Configuration
# ============================================================
# Your MongoDB Atlas connection string
# Replace <db_password> with your actual password
# Replace <cluster-url> with your actual cluster URL
MONGODB_URI=mongodb+srv://<username>:<db_password>@<cluster-url>/<database>?appName=<app-name>

# Database name
MONGODB_DATABASE=edutrack

# ============================================================
# Server Configuration
# ============================================================
SERVER_PORT=8080

# ============================================================
# Frontend Configuration
# ============================================================
VITE_API_BASE_URL=http://localhost:8080/api

# ============================================================
# Demo Login Credentials (Frontend Only)
# ============================================================
# These are used for demo purposes only — no real authentication
DEMO_EMAIL=admin@edutrack.com
DEMO_PASSWORD=admin123
