# ===========================
# EduTrack .gitignore
# ===========================

# ---- Java / Maven ----
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
mvnw
mvnw.cmd

# ---- Spring Boot ----
application-local.properties
application-secret.properties

# ---- Environment Variables ----
.env
.env.local
.env.production

# ---- Node.js / React ----
node_modules/
dist/
build/
.vite/
.cache/

# ---- IDEs ----
.idea/
*.iml
*.iws
.eclipse/
.settings/
.project
.classpath
.factorypath
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# ---- VS Code ----
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Selenium ----
selenium-tests/target/
selenium-tests/screenshots/
